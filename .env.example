# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Game connection -------------------------------------------------------

# Deliveroo.js server.
HOST=http://localhost:8080

# Each agent passes its own NAME to DjsConnect() in code, so the four agents
# can run simultaneously as distinct players. A local player is created on the
# fly when no TOKEN is provided.
#
# Optionally, connect as a specific (persistent) player with a signed token.
# When set, TOKEN takes precedence over the in-code name.
# TOKEN=

# --- LLM provider (Agent B) ------------------------------------------------
# Any OpenAI-compatible endpoint works: switching provider means changing
# these three values only, never the code.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-30b-a3b

# Optional hard timeout per LLM call, in ms (default 30000). The game clock
# must never wait on inference.
# LLM_TIMEOUT_MS=30000

# --- PDDL online solver ----------------------------------------------------
# The pddl-client library reads these; unset means the default endpoint
# (dual-bfws-ffparser). That planner is satisficing rather than optimal, but
# it answers within the few seconds a real-time loop can afford. lama-first
# returns better routes and consistently exceeds the timeout, so the agent
# would fall back to greedy play and lose the planner entirely — a worse plan
# in time beats a better plan too late.
# PAAS_HOST=https://solver.planning.domains:5001
# PAAS_PATH=/package/dual-bfws-ffparser/solve

# --- Team coordination -----------------------------------------------------
# Shared secret for the HMAC handshake between the two team agents. Any random
# string; both agents read the same .env, so one line covers the pair.
# Leave it unset to run either agent solo (no pairing).
# TEAM_SECRET=

# Optional Challenge 2 live-validation password. Used only to obtain a local
# admin token from the validation backend; leave empty to use its documented default.
ADMIN_PASSWORD=

# --- Agent A: strategy profile and ablation levers -------------------------
# Named profile: ECO | BALANCED | RICH  (default BALANCED).
# PROFILE=BALANCED
#
# Individual levers override the profile, one at a time, which is what makes
# controlled ablations possible. 1 = on, 0 = off.
# MEMORY=1
# AGING=1
# OPPONENT_PREDICTION=1
# BATCHING=1

# --- Logging ---------------------------------------------------------------
# DEBUG_LOG=1   # Agent A: log every intention change
# DEBUG_LLM=1   # Agent B: log the full ReAct trace of each interpretation

# --- Optional live-validation resources -----------------------------------
# These external directories are required only by the PowerShell challenge
# harnesses under validation/. They are not needed for normal agent execution
# or deterministic tests. Leave them empty in the example and configure them
# locally when the official course resources are available.
DELIVEROO_BACKEND_DIR=
DELIVEROO_GAMES_DIR=
MISSION_AGENTS_DIR=
